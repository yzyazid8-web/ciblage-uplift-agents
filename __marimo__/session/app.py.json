mail homme&quot;,[&quot;integer&quot;,&quot;int64&quot;]],[&quot;e-mail femme&quot;,[&quot;integer&quot;,&quot;int64&quot;]],[&quot;rien&quot;,[&quot;integer&quot;,&quot;int64&quot;]],[&quot;uplift pr\u00e9dit homme (pts)&quot;,[&quot;number&quot;,&quot;float64&quot;]],[&quot;uplift pr\u00e9dit femme (pts)&quot;,[&quot;number&quot;,&quot;float64&quot;]]]' data-show-filters='true' data-show-download='true' data-show-search='true' data-show-column-summaries='false' data-show-data-types='true' data-show-page-size-selector='false' data-show-column-explorer='true' data-show-chart-builder='true' data-row-headers='[]' data-hidden-columns='[]' data-has-stable-row-id='false' data-lazy='false' data-preload='false'></marimo-table></marimo-ui-element></div>"
